{
  "name": "what-did-i-eat",
  "version": "3.3.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android:clean:dev": "APP_VARIANT=development npx expo prebuild -p android --clean",
    "android:clean:pro": "APP_VARIANT=production npx expo prebuild -p android --clean",
    "android:build:dev": "eas build -p android -e development --local",
    "android:build:dev:emulator": "APP_VARIANT=development npx expo run:android --variant release",
    "android:build:pro": "eas build -p android -e production-apk --local",
    "ios:clean:dev": "APP_VARIANT=development npx expo prebuild -p ios --clean",
    "ios:clean:pro": "APP_VARIANT=production npx expo prebuild -p ios --clean",
    "ios:build:dev": "eas build -p ios -e development --local",
    "ios:build:dev:ipad": "APP_VARIANT=development npx expo run:ios -d 65A50DD7-2AD1-4651-BFB5-E0F9C879CB68 --configuration Release",
    "ios:build:dev:iphone": "APP_VARIANT=development npx expo run:ios -d 6FCBA266-3FB6-4809-ADDA-4CD045EE362F --configuration Release",
    "ios:build:dev:iphone-max": "APP_VARIANT=development npx expo run:ios -d C974B1E1-7364-4E3D-A5F2-72EC38C67812 --configuration Release",
    "ios:build:pro": "APP_VARIANT=production eas build -p ios -e production --local",
    "sim:add-photos": "xcrun simctl addmedia booted apple-submission/sim-images/*.jpg",
    "sim:statusbar": "xcrun simctl status_bar booted override --time 9:41 --batteryState charged --batteryLevel 100 --cellularBars 4 --wifiBars 3",
    "sim:statusbar:clear": "xcrun simctl status_bar booted clear",
    "sim:screenshot": "xcrun simctl io booted screenshot",
    "sim:record": "xcrun simctl io booted recordVideo",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && jest --ci",
    "test": "jest",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/elements": "^2.9.43",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.23",
    "expo-build-properties": "~57.0.22",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.18",
    "expo-location": "~57.0.18",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "react-native-zoom-toolkit": "^5.1.1",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier-eslint": "^17.1.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
